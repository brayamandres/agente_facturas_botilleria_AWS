# ==============================================================================
# Variables de Entorno - Arquitectura Microservicios AWS (Botillería)
# ==============================================================================

# 1. Configuración de Región y Credenciales AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# AWS_SESSION_TOKEN=YOUR_AWS_SESSION_TOKEN # Requerido si usas credenciales temporales de AWS Academy / SSO
# AWS_ENDPOINT_URL=http://localhost:4566   # Descomentar únicamente para pruebas locales con LocalStack

# 2. Recursos de Almacenamiento y Mensajería AWS
S3_BUCKET_NAME=botilleria-facturas-raw
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/botilleria-facturas-queue
DYNAMODB_TABLE_PRODUCTOS=botilleria-productos
DYNAMODB_TABLE_HISTORIAL=botilleria-historial-facturas

# 3. Modelos de Inteligencia Artificial (Worker)
GOOGLE_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Opcional: modelo del asistente web; por defecto usa el proveedor disponible.
# ASSISTANT_MODEL=openai/gpt-oss-120b

# 4. Trazabilidad y Observabilidad (Opcional - LangSmith)
LANGSMITH_API_KEY=YOUR_LANGSMITH_API_KEY
LANGCHAIN_PROJECT=agente-facturas-botilleria-aws
